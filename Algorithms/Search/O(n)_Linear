#include <iostream>
#include <vector>

int main() {
    std::vector<int> array = { 38, 27, 43, 3, 9, 82, 10 };
    int target = 43;
    for (int i = 0; i < array.size(); ++i) {
        if (array[i] == target) {
            std::cout << "Target " << target << " found in array with index: " << i << "\n";
            return 0;
        }
    }
    std::cout << "Target not found";
    return 0;
}